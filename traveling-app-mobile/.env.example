# Optional public frontend overrides. Existing app.json values work without this file.
# Uncomment and replace values before copying to .env.
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
# EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP:5000/api/v1
# Never place backend secrets or provider client secrets in EXPO_PUBLIC_* variables.
