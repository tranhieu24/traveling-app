PORT=5000
NODE_ENV=development
# SSL mode: no-verify (default, recommended for Supabase poolers), verify (strict CA), disable (local Postgres)
DATABASE_SSL=no-verify
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# disabled (default), mock (development/test only), stripe_test (requires TEST credentials)
PAYMENT_MODE=disabled
PAYMENT_HOLD_MINUTES=15
MOCK_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Explicit business tax policy. Default: no tax configured, taxAmount=0.
TAX_RATE=0
# Optional absolute path to a Unicode TTF on the deployment host.
RECEIPT_FONT=
